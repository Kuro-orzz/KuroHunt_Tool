{
  "manifest_version": 3,
  "name": "KuroHunt Tool",
  "version": "1.0.0",
  "description": "Automate course registration at dangkyhoc.vnu.edu.vn",
  "permissions": ["storage"],
  "host_permissions": [
    "https://dangkyhoc.vnu.edu.vn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KuroHunt Tool"
  },
  "content_scripts": [
    {
      "matches": ["https://dangkyhoc.vnu.edu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
